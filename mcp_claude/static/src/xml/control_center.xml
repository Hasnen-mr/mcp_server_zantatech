<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mcp_claude.ControlCenter" owl="1">
        <div t-att-class="'mcp-saas-container ' + (state.themeMode === 'dark' ? 'theme-dark' : 'theme-light')">

            <!-- Clean Top Header (No duplicate navigation options) -->
            <header class="mcp-header">
                <div class="mcp-header-left d-flex align-items-center gap-3">
                    <div class="mcp-brand-logo">
                        <svg class="claude-icon-svg me-2" width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2L14.4 8.3L21 9.3L16.2 14L17.3 20.5L12 17.4L6.7 20.5L7.8 14L3 9.3L9.6 8.3L12 2Z" fill="#D97757"/>
                        </svg>
                        <span class="mcp-brand-title">MCP Claude</span>
                        <span class="mcp-badge-version">v18.0</span>
                    </div>
                    <div class="mcp-page-title-badge px-3 py-1 bg-light border rounded-pill fw-bold text-dark" style="font-size: 13px;">
                        <t t-if="state.activeTab === 'home'"><i class="fa fa-home me-1 text-primary"/> Home Workspace</t>
                        <t t-if="state.activeTab === 'claude'">
                            <svg class="claude-icon-svg me-1" width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 2L14.4 8.3L21 9.3L16.2 14L17.3 20.5L12 17.4L6.7 20.5L7.8 14L3 9.3L9.6 8.3L12 2Z" fill="#D97757"/>
                            </svg> Claude • Odoo MCP
                        </t>
                        <t t-if="state.activeTab === 'dashboard' || state.activeTab === 'dashboards'"><i class="fa fa-line-chart me-1 text-success"/> Analytics &amp; Overview Dashboard</t>
                        <t t-if="state.activeTab === 'tools'"><i class="fa fa-wrench me-1 text-warning"/> MCP Tools Directory</t>
                        <t t-if="state.activeTab === 'configurations'"><i class="fa fa-cog me-1 text-info"/> System Configurations</t>
                    </div>
                </div>
                <div class="mcp-header-right d-flex align-items-center gap-2">
                    <t t-if="state.isSyncing">
                        <span class="badge bg-warning text-dark me-2">
                            <i class="fa fa-refresh fa-spin me-1"></i>Syncing...
                        </span>
                    </t>
                    <t t-if="state.isHttp">
                        <div class="mcp-security-warning-pill me-2" title="Unencrypted HTTP connection detected">
                            <i class="fa fa-exclamation-triangle text-warning me-1"></i> HTTP Unencrypted
                        </div>
                    </t>
                    <button class="btn btn-sm btn-outline-secondary me-2" t-on-click="toggleThemeMode" title="Toggle Light/Dark Theme">
                        <i t-att-class="'fa ' + (state.themeMode === 'dark' ? 'fa-sun-o text-warning' : 'fa-moon-o text-primary')"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary me-2" t-on-click="() => this.state.showShortcutsHelpModal = true" title="Keyboard Shortcuts (?)">
                        <i class="fa fa-keyboard-o"></i>
                    </button>
                    <button class="mcp-quick-search-trigger" t-on-click="() => this.state.showQuickSearch = true">
                        <i class="fa fa-search me-2"></i>Quick Search (Ctrl+K)
                    </button>
                </div>
            </header>

            <!-- Main Content Hub -->
            <main class="mcp-content-hub">

                <!-- 1. HOME TAB (Primary AI Workspace) -->
                <t t-if="state.activeTab === 'home'">
                    <div class="mcp-tab-pane mcp-tab-pane-scrollable animate-fade-in">
                        <div class="row g-4">
                            <!-- Left Column: AI Assistant Chat Workspace -->
                            <div class="col-lg-8">
                                <div class="mcp-card bg-white border rounded-4 shadow-sm p-4 h-100 d-flex flex-column">
                                    <div class="d-flex align-items-center justify-content-between pb-3 border-bottom mb-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="p-2 bg-primary-subtle text-primary rounded-circle">
                                                <i class="fa fa-magic fs-5"/>
                                            </div>
                                            <div>
                                                <h5 class="fw-bold mb-0 text-dark">MCP AI Odoo Assistant</h5>
                                                <small class="text-muted">Global ERP workflow automation &amp; tools workspace</small>
                                            </div>
                                        </div>
                                        <span class="badge bg-success-subtle text-success border border-success px-3 py-1 rounded-pill">
                                            <i class="fa fa-circle text-success me-1 fs-6"/> Active Session
                                        </span>
                                    </div>

                                    <!-- Embedded AI Chat Container -->
                                    <div class="mcp-embedded-chat-container flex-grow-1 border rounded-3 p-3 bg-light" style="min-height: 420px; max-height: 550px;">
                                        <AIChatWindow />
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column: System Status & Quick Actions -->
                            <div class="col-lg-4 d-flex flex-column gap-3">
                                <!-- Active AI Provider Status Card -->
                                <div class="mcp-card bg-white border rounded-4 shadow-sm p-3">
                                    <h6 class="fw-bold text-dark mb-3"><i class="fa fa-bolt text-warning me-2"/>Active AI Engine</h6>
                                    <div class="d-flex align-items-center justify-content-between p-2 bg-light rounded-3 mb-2">
                                        <span class="text-muted small">Active Provider</span>
                                        <span class="fw-bold text-primary" t-esc="state.configForm.ai_provider === 'openai' ? 'OpenAI GPT-4o' : 'Anthropic Claude'"/>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between p-2 bg-light rounded-3 mb-2">
                                        <span class="text-muted small">Server Proxy</span>
                                        <span class="badge bg-success text-white">Port 8443 (HTTPS)</span>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between p-2 bg-light rounded-3">
                                        <span class="text-muted small">Available Tools</span>
                                        <span class="badge bg-primary text-white" t-esc="state.tools.length + ' Tools'"/>
                                    </div>
                                </div>

                                <!-- Useful Quick Actions Shortcuts -->
                                <div class="mcp-card bg-white border rounded-4 shadow-sm p-3">
                                    <h6 class="fw-bold text-dark mb-3"><i class="fa fa-flash text-primary me-2"/>Quick Actions</h6>
                                    <div class="d-flex flex-column gap-2">
                                        <button class="btn btn-sm btn-outline-primary text-start rounded-3 d-flex align-items-center gap-2" t-on-click="setTabClaude">
                                            <svg class="claude-icon-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M12 2L14.4 8.3L21 9.3L16.2 14L17.3 20.5L12 17.4L6.7 20.5L7.8 14L3 9.3L9.6 8.3L12 2Z" fill="#D97757"/>
                                            </svg>
                                            <span>Open Dedicated Claude Chat</span>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary text-start rounded-3" t-on-click="setTabTools">
                                            <i class="fa fa-search me-2"/>Browse 94 MCP Tools
                                        </button>
                                        <button class="btn btn-sm btn-outline-success text-start rounded-3" t-on-click="setTabConfigurations">
                                            <i class="fa fa-sliders me-2"/>Configure AI Provider Keys
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- 2. CLAUDE TAB (Dedicated Polished Claude Workspace) -->
                <t t-if="state.activeTab === 'claude'">
                    <div class="mcp-tab-pane animate-fade-in">
                        <div class="mcp-claude-workspace d-flex">
                            
                            <!-- Left Sidebar: Conversations List -->
                            <aside class="claude-sidebar p-3">
                                <div class="claude-sidebar-header d-flex flex-column gap-3 mb-3">
                                    <button class="btn claude-new-chat-btn w-100 py-2 d-flex align-items-center justify-content-center gap-2" t-on-click="createNewClaudeChat" t-att-disabled="state.claudeSending">
                                    <i class="fa fa-plus text-danger" style="color: var(--claude-accent) !important;"/>
                                    <span>+ New chat</span>
                                </button>

                                    <!-- Search conversations -->
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-white border-end-0"><i class="fa fa-search text-muted"></i></span>
                                        <input type="text" class="form-control border-start-0 bg-white" placeholder="Search conversations..." t-model="state.claudeSidebarSearch"/>
                                    </div>
                                </div>

                                <!-- Grouped Conversation Threads with Smart Titles -->
                                <div class="claude-threads-list flex-grow-1 overflow-auto d-flex flex-column gap-3">
                                    <t t-set="groups" t-value="this.getGroupedClaudeConversations()"/>

                                    <!-- TODAY -->
                                    <t t-if="groups.today.length > 0">
                                        <div>
                                            <div class="text-uppercase fw-bold text-muted px-2 mb-1" style="font-size: 10px; letter-spacing: 0.8px;">TODAY</div>
                                            <t t-foreach="groups.today" t-as="c" t-key="c.id">
                                                <div class="claude-chat-item text-truncate d-flex align-items-center justify-content-between" t-att-class="state.claudeActiveConvId === c.id ? 'active' : ''" t-on-click="() => this.loadClaudeMessages(c.id)">
                                                    <div class="text-truncate me-2">
                                                        <i class="fa fa-comment-o me-2 text-muted"/>
                                                        <span t-esc="c.display_name || c.name || ('Chat #' + c.id)"/>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </t>

                                    <!-- YESTERDAY -->
                                    <t t-if="groups.yesterday.length > 0">
                                        <div>
                                            <div class="text-uppercase fw-bold text-muted px-2 mb-1" style="font-size: 10px; letter-spacing: 0.8px;">YESTERDAY</div>
                                            <t t-foreach="groups.yesterday" t-as="c" t-key="c.id">
                                                <div class="claude-chat-item text-truncate d-flex align-items-center justify-content-between" t-att-class="state.claudeActiveConvId === c.id ? 'active' : ''" t-on-click="() => this.loadClaudeMessages(c.id)">
                                                    <div class="text-truncate me-2">
                                                        <i class="fa fa-comment-o me-2 text-muted"/>
                                                        <span t-esc="c.display_name || c.name || ('Chat #' + c.id)"/>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </t>

                                    <!-- PREVIOUS 7 DAYS -->
                                    <t t-if="groups.prev7Days.length > 0">
                                        <div>
                                            <div class="text-uppercase fw-bold text-muted px-2 mb-1" style="font-size: 10px; letter-spacing: 0.8px;">PREVIOUS 7 DAYS</div>
                                            <t t-foreach="groups.prev7Days" t-as="c" t-key="c.id">
                                                <div class="claude-chat-item text-truncate d-flex align-items-center justify-content-between" t-att-class="state.claudeActiveConvId === c.id ? 'active' : ''" t-on-click="() => this.loadClaudeMessages(c.id)">
                                                    <div class="text-truncate me-2">
                                                        <i class="fa fa-comment-o me-2 text-muted"/>
                                                        <span t-esc="c.display_name || c.name || ('Chat #' + c.id)"/>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                </div>
                            </aside>

                            <!-- Main Chat Area -->
                            <section class="claude-main-chat flex-grow-1 p-4 d-flex flex-column justify-content-between position-relative">
                                
                                <!-- Header -->
                                <div class="claude-chat-header-fixed claude-chat-max-width d-flex align-items-center justify-content-between pb-3 border-bottom mb-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <svg class="claude-icon-svg" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M12 2L14.4 8.3L21 9.3L16.2 14L17.3 20.5L12 17.4L6.7 20.5L7.8 14L3 9.3L9.6 8.3L12 2Z" fill="#D97757"/>
                                        </svg>
                                        <h4 class="fw-bold mb-0 text-dark" style="font-family: Georgia, serif;">Claude</h4>
                                        <span class="badge bg-light text-muted border ms-2" style="font-size: 11px;">Claude • Odoo MCP</span>
                                    </div>
                                    <button class="btn btn-sm btn-outline-secondary rounded-pill" t-on-click="createNewClaudeChat">
                                        <i class="fa fa-refresh me-1"/>New Thread
                                    </button>
                                </div>

                                <!-- Empty State Welcome Screen (when zero messages) -->
                                <t t-if="state.claudeMessages.length === 0">
                                    <div class="claude-welcome-container my-auto text-center py-5 claude-chat-max-width">
                                        <div class="mb-3">
                                            <svg class="claude-icon-svg" width="56" height="56" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M12 2L14.4 8.3L21 9.3L16.2 14L17.3 20.5L12 17.4L6.7 20.5L7.8 14L3 9.3L9.6 8.3L12 2Z" fill="#D97757"/>
                                            </svg>
                                        </div>
                                        <h1 class="fw-bold mb-2 text-dark" style="font-family: Georgia, serif; font-size: 36px;">Claude</h1>
                                        <p class="text-muted fs-5 mb-5">How can I help you today?</p>

                                        <!-- Quick Action Prompt Cards -->
                                        <div class="row g-3 text-start">
                                            <div class="col-md-6">
                                                <div class="claude-prompt-card" t-on-click="() => this.sendClaudePrompt('can you search contact named deepak gulani')">
                                                    <div class="fw-bold mb-1 text-dark"><i class="fa fa-search me-2 text-warning"/>Search your Odoo contacts</div>
                                                    <small class="text-muted">Find partners, emails, and phone numbers in res.partner</small>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="claude-prompt-card" t-on-click="() => this.sendClaudePrompt('show me 5 latest crm opportunities')">
                                                    <div class="fw-bold mb-1 text-dark"><i class="fa fa-line-chart me-2 text-success"/>Analyze CRM opportunities</div>
                                                    <small class="text-muted">List recent leads, expected revenue, and pipeline status</small>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="claude-prompt-card" t-on-click="() => this.sendClaudePrompt('check recent twilio call logs')">
                                                    <div class="fw-bold mb-1 text-dark"><i class="fa fa-phone me-2 text-info"/>Check recent call logs</div>
                                                    <small class="text-muted">Review outbound call history and dialer statuses</small>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="claude-prompt-card" t-on-click="() => this.sendClaudePrompt('how do I create an Odoo partner record?')">
                                                    <div class="fw-bold mb-1 text-dark"><i class="fa fa-plus-circle me-2 text-primary"/>Create an Odoo record</div>
                                                    <small class="text-muted">Generate new contacts or leads through MCP tools</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>

                                <!-- Active Messages Area -->
                                <t t-else="">
                                    <div class="claude-messages-container claude-chat-max-width mb-3" t-ref="claudeMessagesBody">
                                        <t t-foreach="state.claudeMessages" t-as="msg" t-key="msg.id">
                                            <div class="d-flex flex-column mb-3" t-att-class="msg.role === 'user' ? 'align-items-end' : 'align-items-start'">
                                                <t t-if="msg.role === 'user'">
                                                    <div class="p-3 rounded-4 text-dark max-w-75 shadow-sm" style="background-color: var(--claude-surface) !important; border: 1px solid var(--claude-border);">
                                                        <div style="white-space: pre-wrap;" t-esc="msg.content"/>
                                                    </div>
                                                </t>
                                                <t t-else="">
                                                    <div class="d-flex gap-3 max-w-85">
                                                        <div class="p-2 bg-white border rounded-circle align-self-start shadow-sm" style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                                            <svg class="claude-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                <path d="M12 2L14.4 8.3L21 9.3L16.2 14L17.3 20.5L12 17.4L6.7 20.5L7.8 14L3 9.3L9.6 8.3L12 2Z" fill="#D97757"/>
                                                            </svg>
                                                        </div>
                                                        <div class="flex-grow-1">
                                                            <!-- Approval Card -->
                                                            <t t-if="msg.content &amp;&amp; (msg.content.includes('Approval request') || msg.content.includes('pending user approval'))">
                                                                <div class="p-3 bg-white border border-warning rounded-4 shadow-sm text-start mb-2 my-2">
                                                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                                                        <div class="fw-bold text-dark"><i class="fa fa-phone me-2 text-warning"/>Call Contact Approval</div>
                                                                        <span class="badge bg-warning-subtle text-dark border border-warning"><i class="fa fa-clock-o me-1"/>Waiting for your approval</span>
                                                                    </div>
                                                                    <div class="small mb-3 text-muted" style="white-space: pre-wrap;" t-esc="msg.content"/>
                                                                    <div class="d-flex align-items-center justify-content-end gap-2 pt-2 border-top">
                                                                        <button class="btn btn-sm btn-outline-secondary px-3 rounded-pill">Cancel</button>
                                                                        <button class="btn btn-sm btn-primary px-3 rounded-pill" style="background-color: var(--claude-accent); border: none;">Approve call</button>
                                                                    </div>
                                                                </div>
                                                            </t>
                                                            <t t-else="">
                                                                <div class="p-3 rounded-4 bg-white border text-dark shadow-sm">
                                                                    <div style="white-space: pre-wrap; line-height: 1.6;" t-esc="msg.content"/>
                                                                </div>
                                                            </t>
                                                        </div>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                    </div>
                                </t>

                                <!-- Message Composer at Bottom -->
                                <div class="claude-composer-floating p-2 d-flex align-items-center gap-2">
                                    <textarea class="form-control border-0 shadow-none bg-transparent" 
                                              rows="1" 
                                              placeholder="Ask Claude anything..." 
                                              t-model="state.claudePromptText" 
                                              t-on-keydown="onClaudeComposerKeyDown" 
                                              t-att-disabled="state.claudeSending"
                                              style="resize: none; font-size: 15px;"></textarea>
                                    <button class="claude-send-btn flex-shrink-0 me-1" 
                                            t-on-click="() => this.sendClaudePrompt()" 
                                            t-att-disabled="state.claudeSending || !state.claudePromptText.trim()"
                                            title="Send message (Enter)">
                                        <t t-if="state.claudeSending"><i class="fa fa-spinner fa-spin"/></t>
                                        <t t-else=""><i class="fa fa-arrow-up"/></t>
                                    </button>
                                </div>

                            </section>
                        </div>
                    </div>
                </t>

                <!-- 3. DASHBOARD TAB (High-level Overview & BI Analytics) -->
                <t t-if="state.activeTab === 'dashboard' || state.activeTab === 'dashboards'">
                    <div class="mcp-tab-pane mcp-tab-pane-scrollable animate-fade-in">
                        <!-- Overview Statistics Cards -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-3">
                                <div class="mcp-card bg-white border rounded-4 p-3 shadow-sm text-center">
                                    <div class="text-muted small mb-1">Active AI Provider</div>
                                    <h5 class="fw-bold text-primary mb-0" t-esc="state.configForm.ai_provider === 'openai' ? 'OpenAI GPT-4o' : 'Anthropic Claude'"/>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mcp-card bg-white border rounded-4 p-3 shadow-sm text-center">
                                    <div class="text-muted small mb-1">MCP Connection Status</div>
                                    <h5 class="fw-bold text-success mb-0"><i class="fa fa-check-circle me-1"/>Online (Active)</h5>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mcp-card bg-white border rounded-4 p-3 shadow-sm text-center">
                                    <div class="text-muted small mb-1">Registered MCP Tools</div>
                                    <h5 class="fw-bold text-dark mb-0" t-esc="state.tools.length"/>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mcp-card bg-white border rounded-4 p-3 shadow-sm text-center">
                                    <div class="text-muted small mb-1">Twilio Dialer Status</div>
                                    <h5 class="fw-bold mb-0" t-att-class="state.configForm.enable_twilio_dialer ? 'text-success' : 'text-muted'">
                                        <t t-if="state.configForm.enable_twilio_dialer"><i class="fa fa-phone me-1"/>Enabled</t>
                                        <t t-else="">Disabled</t>
                                    </h5>
                                </div>
                            </div>
                        </div>

                        <!-- Recent Activity & System Logs -->
                        <div class="mcp-card bg-white border rounded-4 p-4 shadow-sm mb-4">
                            <h6 class="fw-bold text-dark mb-3"><i class="fa fa-history me-2 text-info"/>Recent Operations &amp; Audit Trail</h6>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th>Tool / Operation</th>
                                            <th>Target Model</th>
                                            <th>Action Type</th>
                                            <th>Execution Status</th>
                                            <th>Timestamp</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="state.auditLogs.length === 0">
                                            <tr>
                                                <td colspan="5" class="text-center text-muted py-4">No recent tool operations logged yet.</td>
                                            </tr>
                                        </t>
                                        <t t-else="">
                                            <t t-foreach="state.auditLogs" t-as="log" t-key="log.id">
                                                <tr>
                                                    <td><strong class="font-monospace text-primary" t-esc="log.tool_name || 'System Operation'"/></td>
                                                    <td><code t-esc="log.model_name || 'N/A'"/></td>
                                                    <td><span class="badge bg-secondary" t-esc="log.action_type || 'Execute'"/></td>
                                                    <td>
                                                        <span t-attf-class="badge #{log.status === 'success' ? 'bg-success' : 'bg-warning'}" t-esc="log.status || 'Completed'"/>
                                                    </td>
                                                    <td class="text-muted small" t-esc="log.create_date"/>
                                                </tr>
                                            </t>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- 4. TOOLS TAB (Dedicated MCP Tools Directory) -->
                <t t-if="state.activeTab === 'tools'">
                    <div class="mcp-tab-pane mcp-tab-pane-scrollable animate-fade-in">
                        <!-- Search & Filter Bar -->
                        <div class="mcp-card mb-4 p-4 bg-white border shadow-sm rounded-4">
                            <div class="row g-3 align-items-center">
                                <div class="col-md-6">
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text bg-light border-end-0"><i class="fa fa-search text-muted"></i></span>
                                        <input type="text" class="form-control border-start-0 bg-light" placeholder="Search tools..." t-model="state.toolsSearchQuery"/>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="d-flex flex-wrap gap-1 justify-content-md-end">
                                        <button class="btn btn-sm" t-att-class="state.selectedToolCategory === 'all' ? 'btn-primary' : 'btn-outline-secondary'" t-on-click="() => this.state.selectedToolCategory = 'all'">All</button>
                                        <button class="btn btn-sm" t-att-class="state.selectedToolCategory === 'contacts' ? 'btn-primary' : 'btn-outline-secondary'" t-on-click="() => this.state.selectedToolCategory = 'contacts'">Contacts</button>
                                        <button class="btn btn-sm" t-att-class="state.selectedToolCategory === 'crm' ? 'btn-primary' : 'btn-outline-secondary'" t-on-click="() => this.state.selectedToolCategory = 'crm'">CRM</button>
                                        <button class="btn btn-sm" t-att-class="state.selectedToolCategory === 'sales' ? 'btn-primary' : 'btn-outline-secondary'" t-on-click="() => this.state.selectedToolCategory = 'sales'">Sales</button>
                                        <button class="btn btn-sm" t-att-class="state.selectedToolCategory === 'inventory' ? 'btn-primary' : 'btn-outline-secondary'" t-on-click="() => this.state.selectedToolCategory = 'inventory'">Inventory</button>
                                        <button class="btn btn-sm" t-att-class="state.selectedToolCategory === 'accounting' ? 'btn-primary' : 'btn-outline-secondary'" t-on-click="() => this.state.selectedToolCategory = 'accounting'">Accounting</button>
                                        <button class="btn btn-sm" t-att-class="state.selectedToolCategory === 'projects' ? 'btn-primary' : 'btn-outline-secondary'" t-on-click="() => this.state.selectedToolCategory = 'projects'">Projects</button>
                                        <button class="btn btn-sm" t-att-class="state.selectedToolCategory === 'technical' ? 'btn-primary' : 'btn-outline-secondary'" t-on-click="() => this.state.selectedToolCategory = 'technical'">Technical</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tools Grid -->
                        <div class="row g-3">
                            <t t-foreach="this.getFilteredTools()" t-as="tool" t-key="tool.id">
                                <div class="col-md-6 col-lg-4">
                                    <div class="mcp-card bg-white border rounded-4 p-3 shadow-sm h-100 d-flex flex-column justify-content-between">
                                        <div>
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <span class="badge bg-primary-subtle text-primary border border-primary px-2 py-1 rounded-pill small" t-esc="tool.category || 'General'"/>
                                                <span class="badge bg-light text-dark border font-monospace" style="font-size: 10px;" t-esc="tool.operation || 'search'"/>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-1 font-monospace" t-esc="tool.name"/>
                                            <p class="text-muted small mb-2" t-esc="tool.description || 'No description provided'"/>
                                        </div>
                                        <div class="pt-2 border-top d-flex align-items-center justify-content-between text-muted small">
                                            <span>Model: <code class="text-primary" t-esc="tool.model_name || 'N/A'"/></span>
                                            <span class="badge bg-success-subtle text-success">Built-in</span>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>

                <!-- 5. CONFIGURATIONS TAB (Central Configuration UI) -->
                <t t-if="state.activeTab === 'configurations'">
                    <div class="mcp-tab-pane mcp-tab-pane-scrollable animate-fade-in max-w-4xl mx-auto">
                        
                        <!-- AI Provider Selection Card -->
                        <div class="mcp-card bg-white border rounded-4 shadow-sm p-4 mb-4">
                            <h5 class="fw-bold text-dark mb-3"><i class="fa fa-bolt me-2 text-warning"/>Active AI Provider Selection</h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="mcp-provider-option p-3 border rounded-3 d-flex align-items-center gap-3 cursor-pointer w-100" t-att-class="state.configForm.ai_provider === 'claude' ? 'border-primary bg-primary-subtle' : 'bg-light'">
                                        <input type="radio" name="ai_provider" value="claude" t-model="state.configForm.ai_provider"/>
                                        <div>
                                            <div class="fw-bold text-dark">Anthropic Claude</div>
                                            <small class="text-muted">Claude 3.5 Sonnet flagship model</small>
                                        </div>
                                    </label>
                                </div>
                                <div class="col-md-6">
                                    <label class="mcp-provider-option p-3 border rounded-3 d-flex align-items-center gap-3 cursor-pointer w-100" t-att-class="state.configForm.ai_provider === 'openai' ? 'border-primary bg-primary-subtle' : 'bg-light'">
                                        <input type="radio" name="ai_provider" value="openai" t-model="state.configForm.ai_provider"/>
                                        <div>
                                            <div class="fw-bold text-dark">OpenAI</div>
                                            <small class="text-muted">GPT-4o Omnimodal flagship model</small>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Anthropic Claude Configuration Card -->
                        <div class="mcp-card bg-white border rounded-4 shadow-sm p-4 mb-4">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <h5 class="fw-bold text-dark mb-0"><i class="fa fa-cloud me-2 text-primary"/>Anthropic Claude Settings</h5>
                                <span class="badge bg-primary-subtle text-primary">LLM Engine</span>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-7">
                                    <label class="form-label fw-bold">API Key</label>
                                    <input type="password" class="form-control" placeholder="••••••••••••••••" t-model="state.configForm.claude_api_key"/>
                                    <small class="text-muted">Key is stored encrypted server-side and never displayed in full.</small>
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label fw-bold">Model</label>
                                    <input type="text" class="form-control" readonly="1" value="claude-3-5-sonnet-20241022"/>
                                </div>
                                <div class="col-12 text-end">
                                    <button class="btn btn-outline-primary btn-sm" t-on-click="() => this.testProviderConnection('claude')" t-att-disabled="state.testingProvider === 'claude'">
                                        <t t-if="state.testingProvider === 'claude'"><i class="fa fa-refresh fa-spin me-1"/>Testing...</t>
                                        <t t-else=""><i class="fa fa-plug me-1"/>Test Claude Connection</t>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- OpenAI Configuration Card -->
                        <div class="mcp-card bg-white border rounded-4 shadow-sm p-4 mb-4">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <h5 class="fw-bold text-dark mb-0"><i class="fa fa-openai me-2 text-success"/>OpenAI Settings</h5>
                                <span class="badge bg-success-subtle text-success">LLM Engine</span>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-7">
                                    <label class="form-label fw-bold">API Key</label>
                                    <input type="password" class="form-control" placeholder="••••••••••••••••" t-model="state.configForm.openai_api_key"/>
                                    <small class="text-muted">Key is stored encrypted server-side and never displayed in full.</small>
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label fw-bold">Model</label>
                                    <select class="form-select" t-model="state.configForm.openai_model">
                                        <option value="gpt-4o">GPT-4o (Omnimodal Flagship)</option>
                                        <option value="gpt-4o-mini">GPT-4o Mini (Fast &amp; Efficient)</option>
                                        <option value="gpt-4-turbo">GPT-4 Turbo</option>
                                    </select>
                                </div>
                                <div class="col-12 text-end">
                                    <button class="btn btn-outline-success btn-sm" t-on-click="() => this.testProviderConnection('openai')" t-att-disabled="state.testingProvider === 'openai'">
                                        <t t-if="state.testingProvider === 'openai'"><i class="fa fa-refresh fa-spin me-1"/>Testing...</t>
                                        <t t-else=""><i class="fa fa-plug me-1"/>Test OpenAI Connection</t>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Twilio Dialer Configuration Card -->
                        <div class="mcp-card bg-white border rounded-4 shadow-sm p-4 mb-4">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <h5 class="fw-bold text-dark mb-0"><i class="fa fa-phone me-2 text-info"/>Twilio Power Dialer Settings</h5>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="enableTwilioSwitch" t-model="state.configForm.enable_twilio_dialer"/>
                                    <label class="form-check-label fw-bold" for="enableTwilioSwitch">Enable Twilio Dialer</label>
                                </div>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label fw-bold">Outgoing Caller ID</label>
                                    <input type="text" class="form-control" t-att-class="state.configForm.twilio_caller_valid ? '' : 'is-invalid'" placeholder="+14155552671 or +919876543210" t-model="state.configForm.twilio_caller_number" t-on-input="validateTwilioNumber"/>
                                    <small class="text-muted d-block mt-1">Phone number used when initiating outbound calls through the dialer.</small>
                                    <t t-if="!state.configForm.twilio_caller_valid">
                                        <div class="invalid-feedback d-block">Please enter a valid E.164 phone number format (e.g. +14155552671 or +919876543210).</div>
                                    </t>
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <button class="btn btn-outline-info btn-sm w-100" t-on-click="() => this.testProviderConnection('twilio')" t-att-disabled="state.testingProvider === 'twilio'">
                                        <t t-if="state.testingProvider === 'twilio'"><i class="fa fa-refresh fa-spin me-1"/>Testing...</t>
                                        <t t-else=""><i class="fa fa-phone me-1"/>Test Twilio Connection</t>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Save Changes Button at Bottom -->
                        <div class="text-end py-3">
                            <button class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm" t-on-click="saveServerConfig" t-att-disabled="state.savingConfig">
                                <t t-if="state.savingConfig"><i class="fa fa-refresh fa-spin me-2"/>Saving Changes...</t>
                                <t t-else=""><i class="fa fa-save me-2"/>Save Changes</t>
                            </button>
                        </div>

                    </div>
                </t>

            </main>

            <!-- Floating Bottom Navigation Application Dock (Exact Order: Home | Claude | Dashboard | Tools | Configurations) -->
            <nav class="mcp-bottom-nav">
                <div class="mcp-nav-pills">
                    <button class="mcp-nav-btn" t-att-class="state.activeTab === 'home' ? 'active' : ''" t-on-click="setTabHome">
                        <i class="fa fa-home"></i>
                        <span>Home</span>
                    </button>
                    <button class="mcp-nav-btn" t-att-class="state.activeTab === 'claude' ? 'active-claude' : ''" t-on-click="setTabClaude">
                        <svg class="claude-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2L14.4 8.3L21 9.3L16.2 14L17.3 20.5L12 17.4L6.7 20.5L7.8 14L3 9.3L9.6 8.3L12 2Z" fill="#D97757"/>
                        </svg>
                        <span>Claude</span>
                    </button>
                    <button class="mcp-nav-btn" t-att-class="(state.activeTab === 'dashboard' || state.activeTab === 'dashboards') ? 'active' : ''" t-on-click="setTabDashboards">
                        <i class="fa fa-line-chart"></i>
                        <span>Dashboard</span>
                    </button>
                    <button class="mcp-nav-btn" t-att-class="state.activeTab === 'tools' ? 'active' : ''" t-on-click="setTabTools">
                        <i class="fa fa-wrench"></i>
                        <span>Tools</span>
                    </button>
                    <button class="mcp-nav-btn" t-att-class="state.activeTab === 'configurations' ? 'active' : ''" t-on-click="setTabConfigurations">
                        <i class="fa fa-cog"></i>
                        <span>Configurations</span>
                    </button>
                </div>
            </nav>

        </div>
    </t>
</templates>