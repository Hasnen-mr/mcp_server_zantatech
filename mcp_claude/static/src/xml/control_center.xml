<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mcp_claude.ControlCenter" owl="1">
        <div class="mcp-saas-container">

            <!-- Header -->
            <header class="mcp-header">
                <div class="mcp-header-left">
                    <div class="mcp-brand-logo">
                        <i class="fa fa-shield me-2 text-primary"></i>
                        <span class="mcp-brand-title">MCP Claude</span>
                        <span class="mcp-badge-version">Enterprise v18.0</span>
                    </div>
                </div>
                <div class="mcp-header-right">
                    <t t-if="state.isHttp">
                        <div class="mcp-security-warning-pill me-3" title="Unencrypted HTTP connection detected">
                            <i class="fa fa-exclamation-triangle text-warning me-1"></i> HTTP Unencrypted (Recommend HTTPS)
                        </div>
                    </t>
                    <button class="mcp-quick-search-trigger">
                        <i class="fa fa-search me-2"></i>Quick Search (Ctrl+K)
                    </button>
                </div>
            </header>

            <!-- Main Content Hub -->
            <main class="mcp-content-hub">

                <!-- 1. HOME HUB -->
                <t t-if="state.activeTab === 'home'">
                    <div class="mcp-tab-pane animate-fade-in">
                        <div class="mcp-hero-card">
                            <div class="mcp-hero-content">
                                <h1 class="mcp-hero-title">Connect Claude Desktop to Odoo</h1>
                                <p class="mcp-hero-subtitle">Enterprise-grade Remote Connector URL or Local Stdio Bridge for Anthropic Claude Desktop.</p>
                                <div class="mcp-hero-actions">
                                    <button class="btn btn-primary btn-lg mcp-connect-hero-btn" t-on-click="copyConnectorUrl">
                                        <i class="fa fa-link me-2"></i>Copy Connector URL
                                    </button>
                                    <button class="btn btn-outline-light btn-lg ms-2" t-on-click="openConnectWizard">
                                        <i class="fa fa-code me-2"></i>How to Connect
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Stats Grid -->
                        <div class="mcp-stats-grid my-4">
                            <div class="mcp-stat-card">
                                <div class="mcp-stat-icon bg-success-light text-success">
                                    <i class="fa fa-server"></i>
                                </div>
                                <div class="mcp-stat-info">
                                    <span class="mcp-stat-label">Odoo Server Status</span>
                                    <span class="mcp-stat-value text-success">Running</span>
                                </div>
                            </div>
                            <div class="mcp-stat-card">
                                <div class="mcp-stat-icon bg-info-light text-info">
                                    <i class="fa fa-plug"></i>
                                </div>
                                <div class="mcp-stat-info">
                                    <span class="mcp-stat-label">Claude Connection</span>
                                    <span class="mcp-stat-value text-info">Ready to Connect</span>
                                </div>
                            </div>
                            <div class="mcp-stat-card">
                                <div class="mcp-stat-icon bg-warning-light text-warning">
                                    <i class="fa fa-key"></i>
                                </div>
                                <div class="mcp-stat-info">
                                    <span class="mcp-stat-label">Active Named Tokens</span>
                                    <span class="mcp-stat-value"><t t-esc="state.stats.activeKeys"></t> Tokens</span>
                                </div>
                            </div>
                            <div class="mcp-stat-card">
                                <div class="mcp-stat-icon bg-primary-light text-primary">
                                    <i class="fa fa-cogs"></i>
                                </div>
                                <div class="mcp-stat-info">
                                    <span class="mcp-stat-label">Registered Tools</span>
                                    <span class="mcp-stat-value"><t t-esc="state.stats.totalTools"></t> Tools</span>
                                </div>
                            </div>
                        </div>

                        <!-- Connect Options & Instructions Section -->
                        <div class="mcp-section-card my-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4 class="mcp-section-title mb-0"><i class="fa fa-bolt text-warning me-2"></i>How to Connect Claude Desktop</h4>
                                <div class="btn-group" role="group">
                                    <button class="btn btn-sm" t-att-class="state.connectOption === 'url' ? 'btn-primary' : 'btn-outline-secondary'" t-on-click="() => this.setConnectOption('url')">
                                        <i class="fa fa-globe me-1"></i>Option 1: Remote SSE URL
                                    </button>
                                    <button class="btn btn-sm" t-att-class="state.connectOption === 'stdio' ? 'btn-primary' : 'btn-outline-secondary'" t-on-click="() => this.setConnectOption('stdio')">
                                        <i class="fa fa-terminal me-1"></i>Option 2: Local Stdio Bridge JSON
                                    </button>
                                </div>
                            </div>

                            <!-- Option 1: Remote SSE URL -->
                            <t t-if="state.connectOption === 'url'">
                                <div class="mcp-url-box p-3 mb-4 border border-primary-subtle rounded">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-primary fs-6"><i class="fa fa-link me-1"></i>Remote Connector URL</span>
                                        <span class="text-muted small">Supports trusted SSL on localhost:8443</span>
                                    </div>
                                    <div class="input-group">
                                        <input type="text" class="form-control form-control-lg font-monospace bg-dark text-info border-secondary" t-att-value="state.connectorUrl" readonly="readonly"/>
                                        <button class="btn btn-primary btn-lg" t-on-click="copyConnectorUrl">
                                            <i class="fa fa-copy me-2"></i>Copy Connector URL
                                        </button>
                                    </div>
                                </div>

                                <div class="mcp-simple-guide-grid">
                                    <div class="mcp-guide-step">
                                        <div class="mcp-guide-step-num">1</div>
                                        <div class="mcp-guide-step-content">
                                            <h6>Open Claude Settings</h6>
                                            <p class="text-muted small mb-0">Open Claude Desktop → Click profile icon → <strong>Settings → Connectors</strong>.</p>
                                        </div>
                                    </div>
                                    <div class="mcp-guide-step">
                                        <div class="mcp-guide-step-num">2</div>
                                        <div class="mcp-guide-step-content">
                                            <h6>Add Custom Connector</h6>
                                            <p class="text-muted small mb-0">Click <strong>Add Custom Connector</strong>.</p>
                                        </div>
                                    </div>
                                    <div class="mcp-guide-step">
                                        <div class="mcp-guide-step-num">3</div>
                                        <div class="mcp-guide-step-content">
                                            <h6>Paste &amp; Add</h6>
                                            <p class="text-muted small mb-0">Name: <code>odoo-claude</code>. Paste Connector URL above → Click <strong>Add</strong>.</p>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <!-- Option 2: Local Stdio Bridge JSON Code -->
                            <t t-if="state.connectOption === 'stdio'">
                                <div class="p-3 mb-4 bg-dark text-white rounded border border-secondary">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-success fs-6"><i class="fa fa-code me-1"></i>claude_desktop_config.json</span>
                                        <button class="btn btn-sm btn-success" t-on-click="copyJsonConfig">
                                            <i class="fa fa-copy me-1"></i>Copy JSON Code
                                        </button>
                                    </div>
                                    <pre class="m-0 p-3 bg-black text-warning font-monospace rounded"><code><t t-esc="state.stdioJsonConfig"></t></code></pre>
                                </div>

                                <div class="mcp-simple-guide-grid">
                                    <div class="mcp-guide-step">
                                        <div class="mcp-guide-step-num">1</div>
                                        <div class="mcp-guide-step-content">
                                            <h6>Copy JSON Code</h6>
                                            <p class="text-muted small mb-0">Click the green <strong>Copy JSON Code</strong> button above.</p>
                                        </div>
                                    </div>
                                    <div class="mcp-guide-step">
                                        <div class="mcp-guide-step-num">2</div>
                                        <div class="mcp-guide-step-content">
                                            <h6>Paste in Configuration</h6>
                                            <p class="text-muted small mb-0">Paste code into <code>%APPDATA%\Claude\claude_desktop_config.json</code> (or MS Store UWP path).</p>
                                        </div>
                                    </div>
                                    <div class="mcp-guide-step">
                                        <div class="mcp-guide-step-num">3</div>
                                        <div class="mcp-guide-step-content">
                                            <h6>Restart Claude Desktop</h6>
                                            <p class="text-muted small mb-0">Quit Claude Desktop completely from system tray and re-open.</p>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <!-- Quick Actions Grid -->
                        <div class="mcp-section-card my-4">
                            <h4 class="mcp-section-title mb-3"><i class="fa fa-rocket text-primary me-2"></i>Quick Actions</h4>
                            <div class="mcp-quick-grid">
                                <button class="mcp-quick-btn" t-on-click="openConnectWizard">
                                    <i class="fa fa-rocket text-primary"></i>
                                    <span>Connect Wizard</span>
                                </button>
                                <button class="mcp-quick-btn" t-on-click="copyConnectorUrl">
                                    <i class="fa fa-copy text-warning"></i>
                                    <span>Copy URL</span>
                                </button>
                                <button class="mcp-quick-btn" t-on-click="copyJsonConfig">
                                    <i class="fa fa-code text-info"></i>
                                    <span>Copy JSON Code</span>
                                </button>
                                <button class="mcp-quick-btn" t-on-click="testConnector">
                                    <i class="fa fa-refresh text-success"></i>
                                    <span>Test Connector</span>
                                </button>
                                <button class="mcp-quick-btn" t-on-click="setTabConfigurations">
                                    <i class="fa fa-sliders text-secondary"></i>
                                    <span>Configurations</span>
                                </button>
                            </div>
                        </div>

                        <!-- Diagnostic Results Panel -->
                        <t t-if="state.testResults">
                            <div class="mcp-section-card my-4 animate-fade-in">
                                <h4 class="mcp-section-title mb-3"><i class="fa fa-flask text-success me-2"></i>Connector Diagnostic Results</h4>
                                <div class="list-group list-group-flush">
                                    <div class="list-group-item bg-transparent text-white d-flex justify-content-between align-items-center">
                                        <span>Server Reachable</span>
                                        <t t-if="state.testResults.serverReachable"><span class="badge bg-success">Passed</span></t>
                                        <t t-else=""><span class="badge bg-danger">Failed</span></t>
                                    </div>
                                    <div class="list-group-item bg-transparent text-white d-flex justify-content-between align-items-center">
                                        <span>Authentication Working (HMAC-SHA256)</span>
                                        <t t-if="state.testResults.authWorking"><span class="badge bg-success">Passed</span></t>
                                        <t t-else=""><span class="badge bg-danger">Failed</span></t>
                                    </div>
                                    <div class="list-group-item bg-transparent text-white d-flex justify-content-between align-items-center">
                                        <span>MCP Endpoint Reachable</span>
                                        <t t-if="state.testResults.mcpEndpoint"><span class="badge bg-success">Passed</span></t>
                                        <t t-else=""><span class="badge bg-danger">Failed</span></t>
                                    </div>
                                    <div class="list-group-item bg-transparent text-white d-flex justify-content-between align-items-center">
                                        <span>Protocol Compatible (2024-11-05)</span>
                                        <t t-if="state.testResults.protocolCompatible"><span class="badge bg-success">Passed</span></t>
                                        <t t-else=""><span class="badge bg-danger">Failed</span></t>
                                    </div>
                                    <div class="list-group-item bg-transparent text-white d-flex justify-content-between align-items-center fw-bold">
                                        <span>Connector Status</span>
                                        <t t-if="state.testResults.connectorReady"><span class="badge bg-success fs-6">Ready to Connect</span></t>
                                        <t t-else=""><span class="badge bg-danger fs-6">Issue Detected</span></t>
                                    </div>
                                </div>
                                <p class="text-muted small mt-3 mb-0"><t t-esc="state.testResults.summary"></t></p>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- 2. TOOLS HUB -->
                <t t-if="state.activeTab === 'tools'">
                    <div class="mcp-tab-pane animate-fade-in">
                        <div class="mcp-page-header">
                            <div>
                                <h2 class="mcp-page-title"><i class="fa fa-wrench me-2"></i>MCP Tools Registry</h2>
                                <p class="mcp-page-sub">Configure active ORM tool functions for AI invocation.</p>
                            </div>
                            <button class="btn btn-primary" t-on-click="openCreateToolModal">
                                <i class="fa fa-plus me-1"></i>New Tool
                            </button>
                        </div>

                        <div class="mcp-card-grid my-4">
                            <t t-foreach="state.tools" t-as="tool" t-key="tool.id">
                                <div class="mcp-tool-card">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h5 class="mcp-tool-name"><t t-esc="tool.name"></t></h5>
                                        <t t-if="tool.active"><span class="badge bg-success">Active</span></t>
                                    </div>
                                    <p class="mcp-tool-desc mt-2"><t t-esc="tool.description or 'No description provided.'"></t></p>
                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                        <span class="text-muted small">ID: #<t t-esc="tool.id"></t></span>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>

                <!-- 3. CONFIGURATIONS HUB (Renamed from Settings) -->
                <t t-if="state.activeTab === 'configurations'">
                    <div class="mcp-tab-pane animate-fade-in">
                        <div class="mcp-page-header mb-4">
                            <div>
                                <h2 class="mcp-page-title"><i class="fa fa-sliders me-2"></i>Configurations</h2>
                                <p class="mcp-page-sub">Manage multi-client tokens, app CRUD permissions, and system controls.</p>
                            </div>
                        </div>

                        <!-- Configurations Sub-Tabs Navigation -->
                        <div class="mcp-settings-subnav mb-4">
                            <button class="mcp-settings-tab-btn" t-att-class="{'active': state.settingsTab === 'connection'}" t-on-click="setSubTabConnection">
                                <i class="fa fa-plug me-2"></i>Connection
                            </button>
                            <button class="mcp-settings-tab-btn" t-att-class="{'active': state.settingsTab === 'authentication'}" t-on-click="setSubTabAuth">
                                <i class="fa fa-key me-2"></i>Tokens &amp; Auth
                            </button>
                            <button class="mcp-settings-tab-btn" t-att-class="{'active': state.settingsTab === 'permissions'}" t-on-click="setSubTabPermissions">
                                <i class="fa fa-shield me-2"></i>Permissions
                            </button>
                            <button class="mcp-settings-tab-btn" t-att-class="{'active': state.settingsTab === 'general'}" t-on-click="setSubTabGeneral">
                                <i class="fa fa-sliders me-2"></i>General
                            </button>
                            <button class="mcp-settings-tab-btn" t-att-class="{'active': state.settingsTab === 'advanced'}" t-on-click="setSubTabAudit">
                                <i class="fa fa-history me-2"></i>Audit Logs
                            </button>
                        </div>

                        <!-- Sub-Tab: Connection -->
                        <t t-if="state.settingsTab === 'connection'">
                            <div class="mcp-section-card">
                                <h4 class="mb-4"><i class="fa fa-desktop text-primary me-2"></i>Remote &amp; Stdio Connection Options</h4>
                                
                                <div class="row g-4 mb-4">
                                    <div class="col-md-6">
                                        <label class="form-label text-muted small uppercase fw-bold">Server Base URL</label>
                                        <input type="text" class="form-control form-control-lg bg-dark text-white border-secondary" t-att-value="state.serverUrl" readonly="readonly"/>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label text-muted small uppercase fw-bold">Authentication Mode</label>
                                        <div class="d-flex align-items-center gap-2"><span t-if="state.httpsEnabled" class="badge bg-success fs-6 p-2">HTTPS Enabled ✅</span><span t-else="" class="badge bg-warning fs-6 p-2">HTTPS Not Configured ⚠️</span></div>
                                    </div>
                                </div>

                                <!-- Option 1: URL -->
                                <div class="p-3 mb-3 bg-dark border border-primary-subtle rounded">
                                    <label class="form-label text-muted small uppercase fw-bold"><i class="fa fa-globe text-primary me-1"></i>Option 1: Remote SSE Connector URL</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control font-monospace bg-dark text-info border-secondary" t-att-value="state.connectorUrl" readonly="readonly"/>
                                        <button class="btn btn-primary" t-on-click="copyConnectorUrl">
                                            <i class="fa fa-copy me-1"></i>Copy URL
                                        </button>
                                    </div>
                                </div>

                                <!-- Option 2: JSON Code -->
                                <div class="p-3 bg-dark border border-secondary rounded">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-label text-muted small uppercase fw-bold mb-0"><i class="fa fa-code text-success me-1"></i>Option 2: Local Stdio Bridge (claude_desktop_config.json)</label>
                                        <button class="btn btn-sm btn-success" t-on-click="copyJsonConfig">
                                            <i class="fa fa-copy me-1"></i>Copy JSON Code
                                        </button>
                                    </div>
                                    <pre class="m-0 p-3 bg-black text-warning font-monospace rounded"><code><t t-esc="state.stdioJsonConfig"></t></code></pre>
                                </div>
                            </div>
                        </t>

                        <!-- Sub-Tab: Tokens & Authentication -->
                        <t t-if="state.settingsTab === 'authentication'">
                            <div class="mcp-section-card">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h4><i class="fa fa-key text-warning me-2"></i>Multi-Client Connector Tokens</h4>
                                    <div>
                                        <button class="btn btn-sm btn-primary me-2" t-on-click="openCreateTokenModal">
                                            <i class="fa fa-plus me-1"></i>New Client Token
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" t-on-click="revokeAllTokens">
                                            <i class="fa fa-ban me-1"></i>Emergency Revoke All
                                        </button>
                                    </div>
                                </div>

                                <div class="table-responsive my-3">
                                    <table class="table mcp-table">
                                        <thead>
                                            <tr>
                                                <th>Token Name</th>
                                                <th>Prefix</th>
                                                <th>Scope</th>
                                                <th>Created</th>
                                                <th>Last Used</th>
                                                <th>Expires</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.apiKeys" t-as="key" t-key="key.id">
                                                <tr>
                                                    <td class="fw-bold"><t t-esc="key.name"></t></td>
                                                    <td><code><t t-esc="key.key_prefix"></t>...</code></td>
                                                    <td><span class="badge bg-secondary"><t t-esc="key.scopes or 'full'"></t></span></td>
                                                    <td><t t-esc="key.create_date"></t></td>
                                                    <td><t t-esc="key.last_used_at or 'Never'"></t></td>
                                                    <td><t t-esc="key.expires_at or 'Never'"></t></td>
                                                    <td>
                                                        <t t-if="key.active"><span class="badge bg-success">Active</span></t>
                                                        <t t-else=""><span class="badge bg-danger">Revoked</span></t>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </t>

                        <!-- Sub-Tab: Permissions (NEW!) -->
                        <t t-if="state.settingsTab === 'permissions'">
                            <div class="mcp-section-card animate-fade-in">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <h4><i class="fa fa-shield text-primary me-2"></i>Odoo Apps &amp; Model CRUD Permissions</h4>
                                        <p class="text-muted small mb-0">Configure granular Read, Create, Write, and Delete access for AI Agents across Odoo applications.</p>
                                    </div>
                                    <span class="badge bg-info p-2 fs-6"><i class="fa fa-info-circle me-1"></i>UI Preview Mode</span>
                                </div>

                                <div class="alert alert-info border-0 rounded-3 mb-4">
                                    <i class="fa fa-lightbulb-o me-2"></i><strong>Permission Control Note:</strong> Fine-grained CRUD controls for sales, invoicing, inventory, and contacts are previewed below. Once URL verification is finalized, live ORM security rules will enforce these toggles.
                                </div>

                                <div class="table-responsive">
                                    <table class="table mcp-table align-middle">
                                        <thead>
                                            <tr>
                                                <th>Odoo Application &amp; Target Model</th>
                                                <th class="text-center">Integration Active</th>
                                                <th class="text-center">Read (Search)</th>
                                                <th class="text-center">Create (New)</th>
                                                <th class="text-center">Write (Update)</th>
                                                <th class="text-center">Delete (Unlink)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.odooAppsPermissions" t-as="app" t-key="app.id">
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            <i t-att-class="'fa ' + app.icon + ' fa-lg text-primary me-3'"></i>
                                                            <div>
                                                                <div class="fw-bold"><t t-esc="app.name"></t></div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="text-center">
                                                        <div class="form-check form-switch d-inline-block">
                                                            <input class="form-check-input" type="checkbox" t-att-checked="app.active" t-on-change="() => this.toggleAppActive(app.id)"/>
                                                        </div>
                                                    </td>
                                                    <td class="text-center">
                                                        <input class="form-check-input" type="checkbox" t-att-checked="app.read" t-att-disabled="!app.active" t-on-change="() => this.toggleAppPermission(app.id, 'read')"/>
                                                    </td>
                                                    <td class="text-center">
                                                        <input class="form-check-input" type="checkbox" t-att-checked="app.create" t-att-disabled="!app.active" t-on-change="() => this.toggleAppPermission(app.id, 'create')"/>
                                                    </td>
                                                    <td class="text-center">
                                                        <input class="form-check-input" type="checkbox" t-att-checked="app.write" t-att-disabled="!app.active" t-on-change="() => this.toggleAppPermission(app.id, 'write')"/>
                                                    </td>
                                                    <td class="text-center">
                                                        <input class="form-check-input" type="checkbox" t-att-checked="app.delete" t-att-disabled="!app.active" t-on-change="() => this.toggleAppPermission(app.id, 'delete')"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </t>

                        <!-- Sub-Tab: General -->
                        <t t-if="state.settingsTab === 'general'">
                            <div class="mcp-section-card">
                                <h4><i class="fa fa-sliders text-info me-2"></i>System Controls</h4>
                                <div class="row g-3 mt-2">
                                    <div class="col-md-6">
                                        <label class="form-label">Rate Limit (RPM)</label>
                                        <input type="number" class="form-control" t-model="state.stats.rateLimitRpm"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Token TTL (Seconds)</label>
                                        <input type="number" class="form-control" value="3600"/>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <!-- Sub-Tab: Advanced Audit Logs -->
                        <t t-if="state.settingsTab === 'advanced'">
                            <div class="mcp-section-card">
                                <h4><i class="fa fa-history text-danger me-2"></i>Security Event Audit Trail</h4>
                                <div class="table-responsive mt-3">
                                    <table class="table mcp-table">
                                        <thead>
                                            <tr>
                                                <th>Event Description</th>
                                                <th>Target Resource</th>
                                                <th>Action Type</th>
                                                <th>Date</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.auditLogs" t-as="log" t-key="log.id">
                                                <tr>
                                                    <td class="fw-bold"><t t-esc="log.tool_name or 'System Event'"></t></td>
                                                    <td><t t-esc="log.model_name or 'N/A'"></t></td>
                                                    <td><span class="badge bg-dark"><t t-esc="log.action_type or 'execute'"></t></span></td>
                                                    <td><t t-esc="log.create_date"></t></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>

            </main>

            <!-- Modals -->
            <t t-if="state.showCreateTokenModal">
                <div class="mcp-modal-backdrop animate-fade-in">
                    <div class="mcp-modal-dialog">
                        <div class="mcp-modal-header">
                            <h3><i class="fa fa-key text-primary me-2"></i>Generate New Client Connector Token</h3>
                            <button class="btn-close btn-close-white" t-on-click="closeCreateTokenModal"></button>
                        </div>
                        <div class="mcp-modal-body">
                            <div class="mb-3">
                                <label class="form-label">Client / Connector Name</label>
                                <input type="text" class="form-control" placeholder="e.g. Claude Desktop, VS Code, Production Agent" t-model="state.newToken.name"/>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Permission Scope</label>
                                <select class="form-select" t-model="state.newToken.scopes">
                                    <option value="full">Full Access (Read/Write)</option>
                                    <option value="read_only">Read Only</option>
                                    <option value="tools_only">Tools Execution Only</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Expiration Policy</label>
                                <select class="form-select" t-model="state.newToken.expiration_policy">
                                    <option value="never">Never Expire</option>
                                    <option value="30_days">30 Days</option>
                                    <option value="90_days">90 Days</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Allowed IPs (Optional Whitelist)</label>
                                <input type="text" class="form-control" placeholder="e.g. 192.168.1.50, 10.0.0.1" t-model="state.newToken.allowed_ips"/>
                            </div>
                        </div>
                        <div class="mcp-modal-footer">
                            <button class="btn btn-secondary" t-on-click="closeCreateTokenModal">Cancel</button>
                            <button class="btn btn-primary" t-on-click="createNamedToken">Generate Token</button>
                        </div>
                    </div>
                </div>
            </t>

            <t t-if="state.showRawTokenModal">
                <div class="mcp-modal-backdrop animate-fade-in">
                    <div class="mcp-modal-dialog">
                        <div class="mcp-modal-header bg-warning-dark">
                            <h3><i class="fa fa-exclamation-triangle text-warning me-2"></i>Copy Your High-Entropy Token</h3>
                            <button class="btn-close btn-close-white" t-on-click="closeRawTokenModal"></button>
                        </div>
                        <div class="mcp-modal-body">
                            <p class="text-warning small">This raw opaque token will be displayed <strong>ONCE</strong> and is never stored in plain text. Copy it now!</p>
                            <div class="mcp-code-preview my-3">
                                <pre><code><t t-esc="state.newlyCreatedRawToken"></t></code></pre>
                            </div>
                            <div class="mcp-url-box p-2">
                                <label class="form-label text-muted small uppercase fw-bold">Ready Connector URL</label>
                                <input type="text" class="form-control font-monospace bg-dark text-info" t-att-value="state.connectorUrl" readonly="readonly"/>
                            </div>
                        </div>
                        <div class="mcp-modal-footer">
                            <button class="btn btn-primary" t-on-click="closeRawTokenModal">Done</button>
                        </div>
                    </div>
                </div>
            </t>

            <t t-if="state.showConnectWizard">
                <div class="mcp-modal-backdrop animate-fade-in">
                    <div class="mcp-modal-dialog mcp-wizard-dialog">
                        <div class="mcp-modal-header">
                            <h3><i class="fa fa-rocket text-primary me-2"></i>Add Custom Connector in Claude Desktop</h3>
                            <button class="btn-close btn-close-white" t-on-click="closeConnectWizard"></button>
                        </div>
                        <div class="mcp-modal-body">
                            <div class="mcp-wizard-step-box mb-4">
                                <h5>Option 1: Remote SSE Connector URL</h5>
                                <div class="input-group my-2">
                                    <input type="text" class="form-control font-monospace bg-dark text-info" t-att-value="state.connectorUrl" readonly="readonly"/>
                                    <button class="btn btn-success" t-on-click="copyConnectorUrl">
                                        <i class="fa fa-copy me-1"></i>Copy URL
                                    </button>
                                </div>
                                <p class="text-muted small mb-0">Paste into <strong>Claude Settings → Connectors → Add Custom Connector</strong>.</p>
                            </div>

                            <div class="mcp-wizard-step-box border-top pt-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h5 class="mb-0">Option 2: Local Stdio Bridge JSON</h5>
                                    <button class="btn btn-sm btn-outline-success" t-on-click="copyJsonConfig">
                                        <i class="fa fa-copy me-1"></i>Copy JSON
                                    </button>
                                </div>
                                <pre class="p-2 bg-dark text-warning font-monospace small rounded"><code><t t-esc="state.stdioJsonConfig"></t></code></pre>
                                <p class="text-muted small mb-0">Paste into <code>claude_desktop_config.json</code>.</p>
                            </div>
                        </div>
                        <div class="mcp-modal-footer">
                            <button class="btn btn-secondary" t-on-click="closeConnectWizard">Close</button>
                        </div>
                    </div>
                </div>
            </t>

            <!-- Bottom Navigation -->
            <nav class="mcp-bottom-nav">
                <div class="mcp-nav-pills">
                    <button class="mcp-nav-btn" t-att-class="{'active': state.activeTab === 'home'}" t-on-click="setTabHome">
                        <i class="fa fa-home"></i>
                        <span>Home</span>
                    </button>
                    <button class="mcp-nav-btn" t-att-class="{'active': state.activeTab === 'tools'}" t-on-click="setTabTools">
                        <i class="fa fa-wrench"></i>
                        <span>Tools</span>
                    </button>
                    <button class="mcp-nav-btn" t-att-class="{'active': state.activeTab === 'configurations'}" t-on-click="setTabConfigurations">
                        <i class="fa fa-sliders"></i>
                        <span>Configurations</span>
                    </button>
                </div>
            </nav>

        </div>
    </t>
</templates>
