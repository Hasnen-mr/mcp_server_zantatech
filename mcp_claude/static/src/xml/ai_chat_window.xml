<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mcp_claude.AIChatWindow">
        <div class="o_mcp_ai_chat_window shadow-lg border rounded-4 d-flex flex-column bg-white">
            <!-- Header (Always 100% Mounted & Interactive) -->
            <div class="o_mcp_ai_chat_header d-flex align-items-center justify-content-between p-3 border-bottom bg-primary text-white rounded-top-4">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa fa-magic fs-5"/>
                    <div>
                        <div class="fw-bold fs-6" title="MCP Claude AI Bubble">MCP Claude AI Bubble</div>
                        <small class="text-white-50" style="font-size: 11px;" t-esc="state.title"/>
                    </div>
                </div>
                <button class="btn btn-sm text-white p-0 border-0" t-on-click="props.onClose" title="MCP Claude AI Bubble - Close">
                    <i class="fa fa-times fs-5"/>
                </button>
            </div>

            <!-- Scope Tabs Navigation Bar (Always 100% Interactive) -->
            <div class="d-flex align-items-center justify-content-around bg-light border-bottom p-1" style="font-size: 12px; pointer-events: auto;">
                <button t-attf-class="btn btn-xs #{state.activeScope === 'record' ? 'btn-primary fw-bold' : 'btn-outline-secondary'} py-1 px-3 rounded-pill cursor-pointer" 
                        t-on-click="() => this.setScope('record')"
                        title="Switch to Record Scope">
                    <i class="fa fa-file-text-o me-1"/>Record
                </button>
                <button t-attf-class="btn btn-xs #{state.activeScope === 'module' ? 'btn-primary fw-bold' : 'btn-outline-secondary'} py-1 px-3 rounded-pill cursor-pointer" 
                        t-on-click="() => this.setScope('module')"
                        title="Switch to Module Scope">
                    <i class="fa fa-cubes me-1"/>Module
                </button>
                <button t-attf-class="btn btn-xs #{state.activeScope === 'global' ? 'btn-primary fw-bold' : 'btn-outline-secondary'} py-1 px-3 rounded-pill cursor-pointer" 
                        t-on-click="() => this.setScope('global')"
                        title="Switch to Global Assistant Scope">
                    <i class="fa fa-globe me-1"/>Global
                </button>
            </div>

            <!-- Main Message Container with Position Relative for Inset Overlay -->
            <div class="o_mcp_ai_chat_body flex-grow-1 p-3 overflow-auto d-flex flex-column gap-3 position-relative" t-ref="chatBody" t-on-scroll="onScroll">
                <!-- Semi-Transparent Skeleton Overlay for Context Switch (>100ms) -->
                <div t-attf-class="o_mcp_skeleton_overlay #{state.isSwitchingThread ? 'o_mcp_active' : ''}">
                    <AIChatSkeleton isOverlay="true"/>
                </div>

                <t t-if="state.initialLoading">
                    <AIChatSkeleton isOverlay="false"/>
                </t>
                <t t-else="">
                    <t t-if="state.history.length === 0">
                        <div class="text-center text-muted my-auto px-3">
                            <i class="fa fa-lightbulb-o fs-1 text-warning mb-2"/>
                            <div class="fw-bold">MCP Claude AI Assistant</div>
                            <small>Ask questions, analyze ERP records, or execute tasks cleanly in this thread.</small>
                        </div>
                    </t>
                    <t t-else="">
                        <t t-foreach="state.history" t-as="msg" t-key="msg.id">
                            <div t-attf-class="d-flex flex-column max-w-85 #{msg.role === 'user' ? 'align-self-end text-end' : 'align-self-start text-start'}">
                                <div t-attf-class="p-3 rounded-4 #{msg.role === 'user' ? 'bg-primary text-white' : (msg.block_type === 'error' ? 'bg-danger-subtle text-danger border border-danger' : 'bg-light text-dark border')}">
                                    <div class="text-break" style="white-space: pre-wrap;" t-esc="msg.content"/>
                                </div>
                            </div>
                        </t>
                    </t>
                </t>
            </div>

            <!-- Footer Input Container -->
            <div class="o_mcp_ai_chat_footer p-3 border-top bg-light rounded-bottom-4">
                <div class="input-group">
                    <textarea class="form-control rounded-3 border-secondary-subtle" 
                              rows="1" 
                              placeholder="Message MCP Claude AI..." 
                              t-model="state.promptText" 
                              t-on-keydown="onKeyDown" 
                              t-att-disabled="state.sending"/>
                    <button class="btn btn-primary rounded-3 px-3" 
                            t-on-click="onSendMessage" 
                            t-att-disabled="state.sending || !state.promptText.trim()">
                        <t t-if="state.sending">
                            <i class="fa fa-spinner fa-spin"/>
                        </t>
                        <t t-else="">
                            <i class="fa fa-paper-plane"/>
                        </t>
                    </button>
                </div>
            </div>
        </div>
    </t>

</templates>
