<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- MCP Claude Control Center Client Action -->
    <record id="action_mcp_claude_control_center" model="ir.actions.client">
        <field name="name">MCP Claude Control Center</field>
        <field name="tag">mcp_claude.control_center</field>
        <field name="target">main</field>
    </record>

    <!-- Root Menu Entry -->
    <menuitem id="menu_mcp_claude_root"
              name="MCP Claude"
              web_icon="mcp_claude,static/description/icon.png"
              sequence="10"/>

    <!-- FIRST SUBMENU: AI Dashboards (Sequence 1) -->
    <menuitem id="menu_mcp_analytics_dashboard_root"
              name="Dashboards"
              parent="menu_mcp_claude_root"
              action="action_mcp_claude_control_center"
              sequence="1"/>

    <!-- SECOND SUBMENU: Control Center / Home (Sequence 2) -->
    <menuitem id="menu_mcp_claude_control_center"
              name="Control Center"
              parent="menu_mcp_claude_root"
              action="action_mcp_claude_control_center"
              sequence="2"/>
</odoo>
